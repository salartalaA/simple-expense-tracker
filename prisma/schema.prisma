generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Expense {
  id         String   @id @default(cuid())
  title      String
  amount     Int
  date       DateTime
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   Category @relation(fields: [categoryId], references: [id])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  icon      String
  createdAt DateTime  @default(now())
  expenses  Expense[]
}
